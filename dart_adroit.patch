+def erdaa(train_episode_rewards,T,args):
+
+    if len(train_episode_rewards)<=10:
+        return 1
+    
+    train_episode_rewards = np.array(train_episode_rewards)
+
+    slopes = np.diff(train_episode_rewards)
+    fluctuation_strength = np.std(slopes)
+    if fluctuation_strength==0:
+            return 1
+    # Fluctuation multiplier. The paper's Adroit runs used *10000 (run-dir suffix `_10000`).
+    # *1000 (no suffix) and *100 (`_100`) are ablation variants; switch by editing this line.
+    first = fluctuation_strength*10000
+    # first = fluctuation_strength*1000
+    # first = fluctuation_strength*100
+    second = fluctuation_strength
+    residuals = np.diff(train_episode_rewards)
+    
+    residuals = first * np.tanh(residuals[-1] / second)
+    T = np.clip(T+residuals, 1, args.tmax)
+    return T
 
